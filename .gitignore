# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Logs
logs/*
!logs/.gitkeep

# Data files: keep raw and processed datasets local by default
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Generated data quality reports
data/quality_reports/*
!data/quality_reports/.gitkeep

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
